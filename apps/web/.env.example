# Backend (Nest) URL. Exposed to the browser, hence the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_URL="http://localhost:5000"

# --- Login com Google: DESLIGADO por padrão ------------------------------------
# Deixe as três variáveis abaixo VAZIAS enquanto o OAuth client do Google não
# existir. Vazio = o botão não aparece, o provider do NextAuth nem é montado
# (/api/auth/signin/google responde 404) e o backend recusa a rota (ver o
# GOOGLE_CLIENT_ID do apps/backend/.env.example). Pra ligar depois: crie o
# client no Google Cloud, preencha as três e RECONSTRUA o web — NEXT_PUBLIC_* é
# inlinado no build, não lido em runtime.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=""

# NextAuth (see lib/auth/options.ts) — used ONLY to run the OAuth handshake
# with Google; its own session is discarded right after (see
# useGoogleOAuthBridge). NEXTAUTH_URL must match this app's public URL (the
# Google Cloud OAuth client's authorized redirect URI is
# "{NEXTAUTH_URL}/api/auth/callback/google"). NEXTAUTH_SECRET encrypts
# NextAuth's own transient session cookie/JWT — any random string, unrelated
# to the backend's JWT_SECRET.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-secret-in-production"
# Same OAuth client as the backend's GOOGLE_CLIENT_ID (see its .env.example).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
