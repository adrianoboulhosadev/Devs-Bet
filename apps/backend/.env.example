DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/devsbet?schema=public"
JWT_SECRET="change-this-secret-in-production"
PORT=5000
# "Sign in with Google" (see GoogleOAuthVerifier). VAZIO = FEATURE DESLIGADA:
# POST /auth/oauth/google responde 404 (GoogleLoginGuard) e o verificador se
# recusa a rodar. Isso não é só cosmético — sem client id a google-auth-library
# PULA a checagem de audience, e um token emitido pra qualquer outro app do
# Google seria aceito aqui. Pra ligar: crie o OAuth client no Google Cloud
# Console (APIs & Services -> Credentials -> OAuth client ID, tipo "Web
# application") e use o MESMO id no apps/web.
GOOGLE_CLIENT_ID=""
# Front (Next) origin. CORS with credentials requires a specific origin.
WEB_ORIGIN="http://localhost:3000"
# Match settlement queue (BullMQ producer). Must point to the same Redis as the worker.
REDIS_URL="redis://localhost:6379"
# Manual Pix deposit destination (the owner's account shown to users topping up).
WALLET_PIX_KEY="owner@example.com"
WALLET_PIX_KEY_TYPE="email"
WALLET_BENEFICIARY_NAME="Devs-Bet"
# City field required by the Pix BR Code QR (merchant city, tag 60).
WALLET_BENEFICIARY_CITY="RIO DE JANEIRO"
