DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/devsbet?schema=public"
JWT_SECRET="change-this-secret-in-production"
PORT=5000
# "Sign in with Google" (see GoogleOAuthVerifier). Must be the SAME client id
# configured in apps/web (NextAuth's GoogleProvider) — it is the expected
# `audience` when verifying the ID token. Get it from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth client ID, type "Web application").
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
# Front (Next) origin. CORS with credentials requires a specific origin.
WEB_ORIGIN="http://localhost:3000"
# Match settlement queue (BullMQ producer). Must point to the same Redis as the worker.
REDIS_URL="redis://localhost:6379"
# Manual Pix deposit destination (the owner's account shown to users topping up).
WALLET_PIX_KEY="owner@example.com"
WALLET_PIX_KEY_TYPE="email"
WALLET_BENEFICIARY_NAME="Devs-Bet"
# City field required by the Pix BR Code QR (merchant city, tag 60).
WALLET_BENEFICIARY_CITY="RIO DE JANEIRO"
