generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- auth ----------------------------------------------------------------------

// Identity/credential. `role` drives authorization (the owner is `admin`); the
// rich domain `User` maps email/password/role to value objects. Money lives in
// the wallet context, never here.
model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  role        String    @default("user")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  lastLoginAt DateTime? @map("last_login_at")

  @@map("users")
}

// Stateful refresh session: one row per login/device. Stores only the HASH of
// the opaque refresh; rotation + reuse detection sustain logout. userId is a
// LOGICAL FK to User (no relation, to avoid coupling contexts).
model AuthSession {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  verifierHash String   @map("verifier_hash")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("auth_sessions")
}

// --- wallet --------------------------------------------------------------------

// The user's money at rest. All amounts are INTEGER CENTS. `available` (a domain
// concept) = balance − held; `held` is the sum reserved by open bets. One wallet
// per user (userId is a LOGICAL FK, @unique). The ledger is part of the aggregate.
model Wallet {
  id        String        @id @default(uuid())
  userId    String        @unique @map("user_id")
  balance   Int           @default(0)
  held      Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  entries   LedgerEntry[]

  @@map("wallets")
}

// Append-only audit of every balance change (deposit, bet_hold, bet_won,
// bet_lost, refund, withdrawal). Never edited or deleted. `referenceId` links to
// the originating bet/payment (logical). `amount` is signed-by-`type` in cents.
model LedgerEntry {
  id          String   @id @default(uuid())
  walletId    String   @map("wallet_id")
  type        String
  amount      Int
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at")
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("ledger_entries")
}

// Money in transit through the owner's bank account (manual Pix model).
// direction: deposit | withdrawal. status: pending | confirmed | rejected | paid.
// `referenceCode` lets the admin match an incoming Pix to a pending deposit.
// userId/confirmedBy are LOGICAL FKs to User.
model Payment {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  direction     String
  amount        Int
  status        String    @default("pending")
  referenceCode String    @unique @map("reference_code")
  confirmedBy   String?   @map("confirmed_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  confirmedAt   DateTime? @map("confirmed_at")

  @@index([userId])
  @@map("payments")
}

// --- match ---------------------------------------------------------------------

// A contest between 2+ participants. status: open → locked → settled | cancelled.
// `winnerParticipantId` is set on settle. `rakeBasisPoints` is the house fee for
// this match (0 = none). creatorId is a LOGICAL FK to User. Participants are part
// of the aggregate (cascade).
model Match {
  id                  String             @id @default(uuid())
  creatorId           String             @map("creator_id")
  title               String
  categoryId          String             @map("category_id")
  imageUrl            String?            @map("image_url")
  status              String             @default("open")
  rakeBasisPoints     Int                @default(0) @map("rake_basis_points")
  bestOf              Int                @default(1) @map("best_of")
  allowsDraw          Boolean            @default(true) @map("allows_draw")
  winnerParticipantId String?            @map("winner_participant_id")
  scheduledAt         DateTime           @map("scheduled_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  lockedAt            DateTime?          @map("locked_at")
  settledAt           DateTime?          @map("settled_at")
  participants        MatchParticipant[]
  units               MatchUnit[]

  @@index([creatorId])
  @@index([categoryId])
  @@map("matches")
}

// A player in a match. May reference a registered friend (userId, logical FK) or
// just carry a displayName for someone off-platform. Bets pick a participant by id.
model MatchParticipant {
  id          String  @id @default(uuid())
  matchId     String  @map("match_id")
  userId      String? @map("user_id")
  displayName String  @map("display_name")
  match       Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@map("match_participants")
}

// One unit (map/leg/round/fight — sport-agnostic) of a bestOf match. Recorded in
// order (unitNumber 1, 2, 3…); winnerParticipantId is null only for the single
// unit of a bestOf-1 match that allowsDraw. The match tallies these to decide
// (and auto-settle) the overall result — see Match.recordUnitResult.
model MatchUnit {
  id                  String  @id @default(uuid())
  matchId             String  @map("match_id")
  unitNumber          Int     @map("unit_number")
  winnerParticipantId String? @map("winner_participant_id")
  match               Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, unitNumber])
  @@index([matchId])
  @@map("match_units")
}

// --- betting -------------------------------------------------------------------

// One bet by one bettor on one SELECTION of a MARKET. A market is either a match
// (marketType 'match', selection = a match participant) or a tournament's champion
// (marketType 'tournament_outright', selection = a tournament participant). status:
// open | won | lost | refunded. `stake`/`payout` in cents; `payout` is filled at
// settlement by the parimutuel PayoutCalculator (same math for every market).
// marketId/bettorId/selectionId are LOGICAL FKs (cross-context — no Prisma relation).
model Bet {
  id          String    @id @default(uuid())
  marketType  String    @default("match") @map("market_type")
  marketId    String    @map("market_id")
  bettorId    String    @map("bettor_id")
  selectionId String    @map("selection_id")
  stake       Int
  status      String    @default("open")
  payout      Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  settledAt   DateTime? @map("settled_at")

  @@index([marketId])
  @@index([bettorId])
  @@map("bets")
}

// --- category ------------------------------------------------------------------

// Self-referential category tree (e.g. games -> e-sports -> Counter Strike).
// `parentId` is null for a root; the self relation stays WITHIN this context.
// A match references a LEAF category (matches.category_id) as a LOGICAL FK
// (cross-context — no Prisma relation there). onDelete: Restrict blocks removing
// a node that still has children (the DeleteCategory use case guards it too).
model Category {
  id        String     @id @default(uuid())
  name      String
  parentId  String?    @map("parent_id")
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children  Category[] @relation("CategoryChildren")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

// --- tournament ----------------------------------------------------------------

// Single-elimination bracket over 2..32 competitors (powers of 2). It ORCHESTRATES
// matches: each confrontation is a plain Match (bracket slot's matchId is a LOGICAL
// FK — no cross-context relation). status: in_progress -> finished | cancelled.
// `championParticipantId` is set when the final is decided. creatorId/categoryId are
// LOGICAL FKs. Participants and slots are part of the aggregate (cascade).
model Tournament {
  id                    String                  @id @default(uuid())
  creatorId             String                  @map("creator_id")
  title                 String
  categoryId            String                  @map("category_id")
  imageUrl              String?                 @map("image_url")
  status                String                  @default("in_progress")
  size                  Int
  rakeBasisPoints       Int                     @default(0) @map("rake_basis_points")
  bestOf                Int                     @default(1) @map("best_of")
  championParticipantId String?                 @map("champion_participant_id")
  scheduledAt           DateTime                @map("scheduled_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  participants          TournamentParticipant[]
  slots                 TournamentSlot[]

  @@index([creatorId])
  @@index([categoryId])
  @@map("tournaments")
}

// A competitor in a tournament; the displayName is the natural key within it. May
// reference a registered user (userId, logical FK) or just carry the name.
model TournamentParticipant {
  id           String     @id @default(uuid())
  tournamentId String     @map("tournament_id")
  userId       String?    @map("user_id")
  displayName  String     @map("display_name")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("tournament_participants")
}

// One node of the bracket at (round, position). Round 0 is the fullest round; the
// last round is the final. `matchId` is the Match that decides it (logical FK, null
// until created); playerAId/playerBId are TournamentParticipant ids (kept as plain
// strings — no relation — since they are filled in as the bracket advances).
model TournamentSlot {
  id           String     @id @default(uuid())
  tournamentId String     @map("tournament_id")
  round        Int
  position     Int
  matchId      String?    @map("match_id")
  playerAId    String?    @map("player_a_id")
  playerBId    String?    @map("player_b_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([matchId])
  @@map("tournament_slots")
}
