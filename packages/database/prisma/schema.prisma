generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- auth ----------------------------------------------------------------------

// Identity/credential. `role` drives authorization (the owner is `admin`); the
// rich domain `User` maps email/password/role to value objects. Money lives in
// the wallet context, never here. `password` is nullable: a user created via an
// OAuth provider (see OAuthAccount) has none — LoginUser (email+password)
// already rejects a null password as invalid credentials.
// `approvalStatus` gates the closed platform (pending | approved | rejected).
// The COLUMN defaults to "approved" on purpose: `db push` applies it to every
// existing row, so the accounts that predate this feature keep working instead
// of locking their owners out. New accounts are never decided by this default —
// the User entity defaults to "pending" and the repository always writes the
// entity's value explicitly.
model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String?
  role           String    @default("user")
  active         Boolean   @default(true)
  nickname       String?
  avatarUrl      String?   @map("avatar_url")
  approvalStatus String    @default("approved") @map("approval_status")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastLoginAt    DateTime? @map("last_login_at")

  @@map("users")
}

// Stateful refresh session: one row per login/device. Stores only the HASH of
// the opaque refresh; rotation + reuse detection sustain logout. userId is a
// LOGICAL FK to User (no relation, to avoid coupling contexts).
model AuthSession {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  verifierHash String   @map("verifier_hash")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("auth_sessions")
}

// Links a User to an external OAuth identity (provider + providerAccountId —
// 'google' today, see GoogleTokenVerifier). Found by (provider,
// providerAccountId) on a repeat login; on the first login the User is
// resolved by email (auto-linked when the provider confirms the email is
// verified) or created fresh (no password) — see LoginWithGoogle. userId is a
// LOGICAL FK to User, same as AuthSession.
model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  email             String
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// --- notification --------------------------------------------------------------

// One line in a user's inbox. `userId` is a LOGICAL FK (the recipient may be a
// bettor or an admin); title/body are stored ALREADY RENDERED by the domain
// (Notification.for) — a notification records what was said at the time, so a
// later wording change never rewrites history.
//
// The @@unique triple is what makes delivery IDEMPOTENT: a retried settlement
// job or a double-clicked confirm re-sends the same (userId, type, referenceId)
// and the write is skipped instead of duplicating the line. Events with nothing
// to reference leave `referenceId` null — in Postgres two NULLs never collide,
// so those are free to repeat (each new deposit request IS a new event).
model Notification {
  id          String    @id
  userId      String    @map("user_id")
  type        String
  title       String
  body        String
  link        String?
  referenceId String?   @map("reference_id")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([userId, type, referenceId])
  @@index([userId, createdAt])
  @@map("notifications")
}

// --- wallet --------------------------------------------------------------------

// The user's money at rest. All amounts are INTEGER CENTS. `available` (a domain
// concept) = balance − held; `held` is the sum reserved by open bets. One wallet
// per user (userId is a LOGICAL FK, @unique). The ledger is part of the aggregate.
model Wallet {
  id        String        @id @default(uuid())
  userId    String        @unique @map("user_id")
  balance   Int           @default(0)
  held      Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  entries   LedgerEntry[]

  @@map("wallets")
}

// Append-only audit of every balance change (deposit, bet_hold, bet_won,
// bet_lost, refund, withdrawal). Never edited or deleted. `referenceId` links to
// the originating bet/payment (logical). `amount` is signed-by-`type` in cents.
model LedgerEntry {
  id          String   @id @default(uuid())
  walletId    String   @map("wallet_id")
  type        String
  amount      Int
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at")
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("ledger_entries")
}

// Money in transit through the owner's bank account (manual Pix model).
// direction: deposit | withdrawal. status: pending | confirmed | rejected | paid.
// `referenceCode` lets the admin match an incoming Pix to a pending deposit.
// userId/confirmedBy are LOGICAL FKs to User.
model Payment {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  direction     String
  amount        Int
  status        String    @default("pending")
  referenceCode String    @unique @map("reference_code")
  // Proof of Pix, mandatory for deposits (uploads/receipts); withdrawals have none.
  receiptUrl    String?   @map("receipt_url")
  confirmedBy   String?   @map("confirmed_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  confirmedAt   DateTime? @map("confirmed_at")

  @@index([userId])
  @@map("payments")
}

// Responsible-gambling self-imposed deposit cap (one row per user per period).
// `amount` is the currently EFFECTIVE cap; a raise is only scheduled
// (`pendingAmount`/`effectiveAt`, 24h grace period) — a lower cap always applies
// immediately. userId is a LOGICAL FK (cross-context, same as Payment/Wallet).
model DepositLimit {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  period        String
  amount        Int
  pendingAmount Int?      @map("pending_amount")
  effectiveAt   DateTime? @map("effective_at")

  @@unique([userId, period])
  @@map("deposit_limits")
}

// Self-imposed block on depositing/betting (responsible gambling). Append-only
// (never updated/cancelled — see the SelfExclusion model): a user may have
// several rows over time, the most recent one is what's checked. `until` null
// means permanent (never ends).
model SelfExclusion {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  period    String
  startedAt DateTime  @default(now()) @map("started_at")
  until     DateTime? @map("until")

  @@index([userId])
  @@map("self_exclusions")
}

// --- participant -----------------------------------------------------------------

// A reusable competitor profile the admin manages once and picks from when
// creating a match/tournament, instead of typing a name every time.
// MatchParticipant/TournamentParticipant snapshot name/nickname/imageUrl from
// here (participantId, logical FK — no Prisma relation, cross-context) at
// creation time; editing/renaming here never rewrites that history.
model Participant {
  id        String   @id @default(uuid())
  name      String   @unique
  nickname  String?
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("participants")
}

// --- match ---------------------------------------------------------------------

// A contest between 2+ participants. status: open → locked → settled | cancelled.
// `winnerParticipantId` is set on settle. `rakeBasisPoints` is the house fee for
// this match (0 = none). creatorId is a LOGICAL FK to User. Participants are part
// of the aggregate (cascade).
model Match {
  id                  String             @id @default(uuid())
  creatorId           String             @map("creator_id")
  title               String
  categoryId          String             @map("category_id")
  imageUrl            String?            @map("image_url")
  status              String             @default("open")
  rakeBasisPoints     Int                @default(0) @map("rake_basis_points")
  bestOf              Int                @default(1) @map("best_of")
  allowsDraw          Boolean            @default(true) @map("allows_draw")
  winnerParticipantId String?            @map("winner_participant_id")
  scheduledAt         DateTime           @map("scheduled_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  lockedAt            DateTime?          @map("locked_at")
  settledAt           DateTime?          @map("settled_at")
  participants        MatchParticipant[]
  units               MatchUnit[]

  @@index([creatorId])
  @@index([categoryId])
  @@map("matches")
}

// A player in a match, picked from the participant catalog (participantId,
// logical FK to Participant). displayName/nickname/imageUrl are a SNAPSHOT
// taken at match-creation time (immutable afterwards, even if the catalog
// entry is later renamed) — see packages/participant. Bets pick a participant
// by id.
model MatchParticipant {
  id            String  @id @default(uuid())
  matchId       String  @map("match_id")
  participantId String  @map("participant_id")
  displayName   String  @map("display_name")
  nickname      String?
  imageUrl      String? @map("image_url")
  match         Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@map("match_participants")
}

// One unit (map/leg/round/fight — sport-agnostic) of a bestOf match. Recorded in
// order (unitNumber 1, 2, 3…); winnerParticipantId is null only for the single
// unit of a bestOf-1 match that allowsDraw. The match tallies these to decide
// (and auto-settle) the overall result — see Match.recordUnitResult.
model MatchUnit {
  id                  String  @id @default(uuid())
  matchId             String  @map("match_id")
  unitNumber          Int     @map("unit_number")
  winnerParticipantId String? @map("winner_participant_id")
  match               Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, unitNumber])
  @@index([matchId])
  @@map("match_units")
}

// --- betting -------------------------------------------------------------------

// One bet by one bettor on one SELECTION of a MARKET. A market is either a match
// (marketType 'match', selection = a match participant) or a tournament's champion
// (marketType 'tournament_outright', selection = a tournament participant). status:
// open | won | lost | refunded. `stake`/`payout` in cents; `payout` is filled at
// settlement by the parimutuel PayoutCalculator (same math for every market).
// marketId/bettorId/selectionId are LOGICAL FKs (cross-context — no Prisma relation).
model Bet {
  id          String    @id @default(uuid())
  marketType  String    @default("match") @map("market_type")
  marketId    String    @map("market_id")
  bettorId    String    @map("bettor_id")
  selectionId String    @map("selection_id")
  stake       Int
  status      String    @default("open")
  payout      Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  settledAt   DateTime? @map("settled_at")

  @@index([marketId])
  @@index([bettorId])
  @@map("bets")
}

// One point of the odds-history chart: the live parimutuel odds of a selection
// at the moment a bet changed its market's pool. Recorded append-only inside
// PlaceBet's transaction (one row per selection with a pool, every time) — combo
// legs never touch the pool, so they never generate a point here.
model OddsSnapshot {
  id          String   @id @default(uuid())
  marketId    String   @map("market_id")
  selectionId String   @map("selection_id")
  pool        Int
  totalPool   Int      @map("total_pool")
  impliedOdd  Float    @map("implied_odd")
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@index([marketId, recordedAt])
  @@map("odds_snapshots")
}

// Responsible-gambling self-imposed daily stake cap (one row per bettor — unlike
// DepositLimit there is only one rolling window here: the last 24h). `amount` is
// the currently EFFECTIVE cap; a raise is only scheduled (`pendingAmount`/
// `effectiveAt`, 24h grace period) — a lower cap always applies immediately.
model StakeLimit {
  id            String    @id @default(uuid())
  bettorId      String    @unique @map("bettor_id")
  amount        Int
  pendingAmount Int?      @map("pending_amount")
  effectiveAt   DateTime? @map("effective_at")

  @@map("stake_limits")
}

// A combo (parlay/accumulator) ticket: FIXED odds locked at placement, unlike
// Bet's parimutuel payout — the same calculation real bookmakers use. `totalOdd`
// is the product of every leg's odd; `payout` (0 until settled) is `stake *
// totalOdd` only if every leg wins. status mirrors Bet (open/won/lost/refunded).
model ComboBet {
  id         String     @id @default(uuid())
  bettorId   String     @map("bettor_id")
  stake      Int
  totalOdd   Float      @map("total_odd")
  status     String     @default("open")
  payout     Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")
  settledAt  DateTime?  @map("settled_at")
  legs       ComboLeg[]

  @@index([bettorId])
  @@map("combo_bets")
}

// One leg of a ComboBet: a market + selection at the odd locked when the ticket
// was placed. marketId/selectionId are LOGICAL FKs (cross-context, same as
// Bet); comboBetId is INTRA-context (the aggregate's own child), so it has a
// Prisma relation, mirroring MatchUnit -> Match. result: pending until the
// underlying market settles, then won/lost/void (a cancelled market).
model ComboLeg {
  id          String   @id @default(uuid())
  comboBetId  String   @map("combo_bet_id")
  comboBet    ComboBet @relation(fields: [comboBetId], references: [id], onDelete: Cascade)
  marketType  String   @default("match") @map("market_type")
  marketId    String   @map("market_id")
  selectionId String   @map("selection_id")
  odd         Float
  result      String   @default("pending")

  @@index([comboBetId])
  @@index([marketId])
  @@map("combo_legs")
}

// --- category ------------------------------------------------------------------

// Self-referential category tree (e.g. games -> e-sports -> Counter Strike).
// `parentId` is null for a root; the self relation stays WITHIN this context.
// A match references a LEAF category (matches.category_id) as a LOGICAL FK
// (cross-context — no Prisma relation there). onDelete: Restrict blocks removing
// a node that still has children (the DeleteCategory use case guards it too).
model Category {
  id        String     @id @default(uuid())
  name      String
  parentId  String?    @map("parent_id")
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children  Category[] @relation("CategoryChildren")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

// --- tournament ----------------------------------------------------------------

// Single-elimination bracket over 2..32 competitors (powers of 2). It ORCHESTRATES
// matches: each confrontation is a plain Match (bracket slot's matchId is a LOGICAL
// FK — no cross-context relation). status: in_progress -> finished | cancelled.
// `championParticipantId` is set when the final is decided. creatorId/categoryId are
// LOGICAL FKs. Participants and slots are part of the aggregate (cascade).
model Tournament {
  id                    String                  @id @default(uuid())
  creatorId             String                  @map("creator_id")
  title                 String
  categoryId            String                  @map("category_id")
  imageUrl              String?                 @map("image_url")
  status                String                  @default("in_progress")
  size                  Int
  rakeBasisPoints       Int                     @default(0) @map("rake_basis_points")
  // One entry per bracket round (index 0 = fullest round, last = the final) —
  // lets e.g. every round be MD3 except an MD5 final.
  bestOfByRound         Int[]                   @default([1]) @map("best_of_by_round")
  championParticipantId String?                 @map("champion_participant_id")
  scheduledAt           DateTime                @map("scheduled_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  participants          TournamentParticipant[]
  slots                 TournamentSlot[]
  groupMatches          TournamentGroupMatch[]

  @@index([creatorId])
  @@index([categoryId])
  @@map("tournaments")
}

// A competitor in a tournament, picked from the participant catalog
// (participantId, logical FK to Participant); the displayName is the natural
// key within it. displayName/nickname/imageUrl are a SNAPSHOT taken at
// tournament-creation time (immutable afterwards) — see packages/participant.
model TournamentParticipant {
  id            String     @id @default(uuid())
  tournamentId  String     @map("tournament_id")
  participantId String     @map("participant_id")
  displayName   String     @map("display_name")
  nickname      String?
  imageUrl      String?    @map("image_url")
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("tournament_participants")
}

// One node of the bracket at (round, position). Round 0 is the fullest round; the
// last round is the final. `matchId` is the Match that decides it (logical FK, null
// until created); playerAId/playerBId are TournamentParticipant ids (kept as plain
// strings — no relation — since they are filled in as the bracket advances).
model TournamentSlot {
  id           String     @id @default(uuid())
  tournamentId String     @map("tournament_id")
  round        Int
  position     Int
  matchId      String?    @map("match_id")
  playerAId    String?    @map("player_a_id")
  playerBId    String?    @map("player_b_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([matchId])
  @@map("tournament_slots")
}

// One round-robin matchup within a group (see Tournament.hasGroupStage, only
// for a > 32-participant tournament) — both players are always known upfront,
// unlike a TournamentSlot's later rounds. unitsWonByA/B feed the group's
// unit-differential standings tiebreak once the matchup settles.
model TournamentGroupMatch {
  id                  String     @id @default(uuid())
  tournamentId        String     @map("tournament_id")
  groupIndex          Int        @map("group_index")
  matchupIndex        Int        @map("matchup_index")
  playerAId           String     @map("player_a_id")
  playerBId           String     @map("player_b_id")
  matchId             String?    @map("match_id")
  winnerParticipantId String?    @map("winner_participant_id")
  unitsWonByA         Int        @default(0) @map("units_won_by_a")
  unitsWonByB         Int        @default(0) @map("units_won_by_b")
  tournament          Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([matchId])
  @@map("tournament_group_matches")
}
